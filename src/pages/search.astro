---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="Search — She Leaves Notes">
  <section class="container-narrow pt-16 md:pt-24 pb-24">
    <p class="eyebrow mb-6">Search</p>
    <h1 class="font-serif text-4xl md:text-5xl mb-10">Find a place, a dish, a hotel.</h1>
    <SearchBox autofocus={true} />
  </section>
</BaseLayout>
