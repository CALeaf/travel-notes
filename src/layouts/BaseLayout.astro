---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = 'Travel notes from Xuenan — what to eat, where to stay, how to get there, and whether to go back.',
  cover,
  ogType = 'website',
  publishedTime,
  tags,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = 'She Leaves Notes';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="dOFrt6wA03JCNleXa2L6QuF2M2WYvbiwgofC17uFP1s" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="She Leaves Notes" href="/rss.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {cover && <meta property="og:image" content={cover} />}
    {cover && <meta property="og:image:alt" content={title} />}

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && tags && tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content={cover ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {cover && <meta name="twitter:image" content={cover} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line">
      <div class="container-prose flex items-center justify-between py-5">
        <a href="/" class="font-serif text-xl tracking-tight">
          She&nbsp;<span class="italic">Leaves</span>&nbsp;Notes
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/" class="link-underline">All</a>
          <a href="/map/" class="link-underline">Map</a>
          <a href="/tags/" class="link-underline">Tags</a>
          <a href="/about/" class="link-underline">About</a>
          <a href="/search/" class="link-underline">Search</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <script is:inline>
      // Tag portrait images so CSS :has() can float them next to body text on tablet+.
      // Runs at parse time using the explicit width/height attributes Astro emits,
      // so there's no flash of unstyled layout.
      (function () {
        const apply = () => {
          document.querySelectorAll('.prose img').forEach((img) => {
            const w = +img.getAttribute('width');
            const h = +img.getAttribute('height');
            if (w && h && h > w * 1.1 && !img.dataset.orientation) {
              img.dataset.orientation = 'portrait';
            }
          });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', apply);
        } else {
          apply();
        }
      })();
    </script>

    <footer class="border-t border-line mt-24">
      <div class="container-prose py-10 text-sm text-muted flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <p class="font-serif italic">She Leaves Notes — a personal travel log.</p>
        <p>&copy; {new Date().getFullYear()}. Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>
